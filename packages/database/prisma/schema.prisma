// ============================================================================
// Frigorífico — Esquema de datos (MVP: Ingreso -> Desposte -> Despacho, bovino)
// PostgreSQL + Prisma
//
// Notas de robustez (se aplican vía migraciones SQL personalizadas, no en
// este schema declarativo):
//   - Triggers de auditoría AFTER INSERT/UPDATE/DELETE en entidades críticas
//   - Particionado RANGE (mensual) de trace_event y tablas de históricos
//   - Constraints CHECK adicionales (ej: quarter_type solo si unit_form=cuarto)
//   - Validación output+shrink ≈ input al cerrar orden de desposte
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ========================================

enum Species {
  bovino
}

enum UnitForm {
  canal_completa
  media_canal
  cuarto
}

enum QuarterType {
  delantero
  trasero
}

enum GoodsReceiptStatus {
  borrador
  confirmado
  en_desposte
  cerrado
  anulado
}

enum GoodsReceiptItemStatus {
  disponible
  en_desposte
  despiezado
  anulado
}

enum TraceUnitType {
  receipt_item
  cut
  package
  shipment
}

enum TraceUnitStatus {
  activa
  bloqueada
  consumida
  despachada
}

enum TraceEventType {
  ingreso
  desposte
  empaque
  despacho
}

enum UserRole {
  desarrollador
  admin
  supervisor
  operario
}

enum DispatchOrderStatus {
  activo
  inactivo
  facturado
}

enum DispatchOrderType {
  mp_a_proceso
}

enum CanalDispatchType {
  caliente
  frio
  posta
}

// ===================== CANAL FRÍA / ÓRDENES DE DESPACHO ====================

// Cliente (a futuro se sincroniza desde el ERP; global, no por planta).
// Un mismo NIT puede tener varias sedes (sucursales): una fila por sede.
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  nit       String
  name      String
  sede      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  canalReceipts CanalReceiptOrder[]
  postaReceipts PostaReceiptOrder[]

  @@unique([nit, sede])
  @@map("client")
}

model Procedencia {
  id        String   @id @default(uuid()) @db.Uuid
  code      Int      @unique @default(autoincrement())
  // NIT de la procedencia (se digita en Peso en Camión en lugar del código).
  nit       String?
  rspp      String?
  concepto  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("procedencia")
}

model Proveedor {
  id        String   @id @default(uuid()) @db.Uuid
  code      Int      @unique @default(autoincrement())
  // NIT del proveedor (se digita en Peso en Camión en lugar del código).
  nit       String?
  concepto  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("proveedor")
}

model Cliente {
  id        String   @id @default(uuid()) @db.Uuid
  code      Int      @unique @default(autoincrement())
  concepto  String   @unique
  nit       String?
  direccion String?
  telefono  String?
  ciudad    String?
  contacto  String?
  correo    String?
  celular   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productos                ClienteProducto[]
  tiendas                  ClienteTienda[]
  bodegas                  Bodega[]
  ordenesDespacho          DispatchOrder[]
  ordenesProduccion        ProductionOrder[]
  ordenesTraslado          TransferOrder[]
  ordenesAcondicionamiento ConditioningOrder[]
  ordenesDespachoCanales   CanalDispatchOrder[]

  @@map("cliente")
}

// Tiendas (puntos de entrega) de un cliente; el código completo es NIT-codigo.
model ClienteTienda {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  codigo    String
  nombre    String
  direccion String?
  ciudad    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cliente                    Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiquetas                  RotuladoEtiqueta[]
  canastillas                RotuladoCanastilla[]
  ordenesProduccion          ProductionOrderTienda[]
  etiquetasAcondicionamiento AcondicionamientoEtiqueta[]

  @@unique([clienteId, codigo])
  @@unique([clienteId, nombre])
  @@map("cliente_tienda")
}

// Bodega interna del software (no es una cava física): donde queda registrado el
// producto de un cliente. Por defecto cada cliente tiene una con su nombre.
model Bodega {
  id        String   @id @default(uuid()) @db.Uuid
  code      Int      @unique @default(autoincrement())
  clienteId String   @map("cliente_id") @db.Uuid
  nombre    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cliente                    Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiquetas                  RotuladoEtiqueta[]
  etiquetasAcondicionamiento AcondicionamientoEtiqueta[]

  @@unique([clienteId, nombre])
  @@map("bodega")
}

// Conservación: productos que se le despostan a cada cliente.
model ClienteProducto {
  clienteId       String   @map("cliente_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  tipo            String   @default("TERMINADO")
  refPluSku       String?  @map("ref_plu_sku")
  refrigeradoDias Int      @default(0) @map("refrigerado_dias")
  refrigeradoTemp String   @default("0°C A 4°C") @map("refrigerado_temp")
  congeladoDias   Int      @default(0) @map("congelado_dias")
  congeladoTemp   String   @default("-18°C A -25°C") @map("congelado_temp")
  // Piezas Desposte: cuántas piezas de este producto salen por canal y cuántas van por caja/canastilla.
  piezasPorCanal  Int      @default(1) @map("piezas_por_canal")
  undsPorCaja     Int      @default(1) @map("unds_por_caja")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clienteId, productId])
  @@index([productId])
  @@map("cliente_producto")
}

model Conductor {
  id        String   @id @default(uuid()) @db.Uuid
  code      Int      @unique @default(autoincrement())
  concepto  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("conductor")
}

enum PesoCamionStatus {
  abierta
  cerrada
}

model PesoCamion {
  id              String           @id @default(uuid()) @db.Uuid
  plantId         String           @map("plant_id") @db.Uuid
  reference       Int
  // Referencia del ganado/finca (lote) que digita el usuario para guiar el proceso.
  // El consecutivo BC (reference) sigue existiendo por debajo, sin mostrarse.
  referenciaLote  String?          @map("referencia_lote")
  date            DateTime         @db.Date
  guia            String?
  procedencia     String?
  proveedor       String?
  cliente         String?
  placa           String?
  conductor       String?
  observaciones   String?
  cantidad        Int?
  entrada         Decimal?         @db.Decimal(12, 2)
  salida          Decimal?         @db.Decimal(12, 2)
  netoKg          Decimal?         @map("neto_kg") @db.Decimal(12, 2)
  pesoPromedioKg  Decimal?         @map("peso_promedio_kg") @db.Decimal(12, 2)
  status          PesoCamionStatus @default(abierta)
  // Estado de la guía en Peso en Pie: se abre con el camión y se cierra aparte.
  pieStatus       PesoCamionStatus @default(abierta) @map("pie_status")
  // Repesaje de la guía ya cerrada en Peso en Pie: número de la última ronda
  // iniciada y si hay una ronda en curso (los animales se repesan en orden).
  repesajeRonda   Int              @default(0) @map("repesaje_ronda")
  repesajeAbierto Boolean          @default(false) @map("repesaje_abierto")
  createdById     String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@unique([plantId, date, reference])
  @@index([plantId, status])
  @@index([plantId, pieStatus])
  @@map("peso_camion")
}

// Orden de Despacho (O.D.): consecutivo propio por planta (OD0000001).
model DispatchOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  odNumber         Int                 @map("od_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clienteId        String              @map("cliente_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  type             DispatchOrderType   @default(mp_a_proceso)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant            Plant               @relation(fields: [plantId], references: [id])
  cliente          Cliente             @relation(fields: [clienteId], references: [id])
  createdBy        AppUser             @relation("dispatchCreatedBy", fields: [createdById], references: [id])
  items            DispatchOrderItem[]
  productionOrders ProductionOrder[]

  @@unique([plantId, odNumber])
  @@index([plantId, status])
  @@map("dispatch_order")
}

// Orden de Despacho de Canales (D.C.): consecutivo propio por planta (DC0000001);
// una sola numeración para el despacho en caliente y el despacho en frío.
model CanalDispatchOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  dcNumber         Int                 @map("dc_number")
  tipo             CanalDispatchType
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clienteId        String              @map("cliente_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant     Plant                    @relation(fields: [plantId], references: [id])
  cliente   Cliente                  @relation(fields: [clienteId], references: [id])
  createdBy AppUser                  @relation("canalDispatchCreatedBy", fields: [createdById], references: [id])
  items     CanalDispatchOrderItem[]
  productos DispatchProductItem[]

  @@unique([plantId, dcNumber])
  @@index([plantId, tipo, status])
  @@map("canal_dispatch_order")
}

// Canal despachada (caliente o frío) en una orden DC: sale de su cava y del inventario.
// No puede estar en una orden de despacho a proceso (esas canales se despostan).
model CanalDispatchOrderItem {
  id                   String   @id @default(uuid()) @db.Uuid
  canalDispatchOrderId String   @map("canal_dispatch_order_id") @db.Uuid
  canalPiezaId         String   @unique @map("canal_pieza_id") @db.Uuid
  cavaOrigen           String   @map("cava_origen")
  pesoCalienteKg       Decimal  @map("peso_caliente_kg") @db.Decimal(12, 2)
  despachoKg           Decimal? @map("despacho_kg") @db.Decimal(12, 2)
  createdById          String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  canalDispatchOrder CanalDispatchOrder @relation(fields: [canalDispatchOrderId], references: [id])
  canalPieza         CanalPieza         @relation(fields: [canalPiezaId], references: [id])
  createdBy          AppUser            @relation("canalDispatchItemCreatedBy", fields: [createdById], references: [id])

  @@index([canalDispatchOrderId])
  @@map("canal_dispatch_order_item")
}

// Producto rotulado (pieza, canastilla o etiqueta de acondicionamiento) despachado en una
// orden DC de posta. Se repesa al despachar; sale del inventario al cerrar la orden.
model DispatchProductItem {
  id                   String   @id @default(uuid()) @db.Uuid
  canalDispatchOrderId String   @map("canal_dispatch_order_id") @db.Uuid
  etiquetaId           String?  @unique @map("etiqueta_id") @db.Uuid
  canastillaId         String?  @unique @map("canastilla_id") @db.Uuid
  acondEtiquetaId      String?  @unique @map("acond_etiqueta_id") @db.Uuid
  codigo               String
  productId            String   @map("product_id") @db.Uuid
  unds                 Int
  pesoKg               Decimal  @map("peso_kg") @db.Decimal(12, 2)
  taraKg               Decimal  @map("tara_kg") @db.Decimal(12, 2)
  netoKg               Decimal  @map("neto_kg") @db.Decimal(12, 2)
  netoEtiquetaKg       Decimal  @map("neto_etiqueta_kg") @db.Decimal(12, 2)
  createdById          String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  canalDispatchOrder CanalDispatchOrder         @relation(fields: [canalDispatchOrderId], references: [id])
  etiqueta           RotuladoEtiqueta?          @relation(fields: [etiquetaId], references: [id])
  canastilla         RotuladoCanastilla?        @relation(fields: [canastillaId], references: [id])
  acondEtiqueta      AcondicionamientoEtiqueta? @relation(fields: [acondEtiquetaId], references: [id])
  product            Product                    @relation(fields: [productId], references: [id])
  createdBy          AppUser                    @relation("dispatchProductItemCreatedBy", fields: [createdById], references: [id])

  @@index([canalDispatchOrderId])
  @@map("dispatch_product_item")
}

// Orden de Traslado (O.T.): consecutivo propio por planta (OT0000001).
model TransferOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  otNumber         Int                 @map("ot_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clienteId        String              @map("cliente_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant              Plant               @relation(fields: [plantId], references: [id])
  cliente            Cliente             @relation(fields: [clienteId], references: [id])
  createdBy          AppUser             @relation("transferCreatedBy", fields: [createdById], references: [id])
  items              TransferOrderItem[]
  conditioningOrders ConditioningOrder[]

  @@unique([plantId, otNumber])
  @@index([plantId, status])
  @@map("transfer_order")
}

// Orden de Acondicionamiento (O.C.): consecutivo propio por planta (OC0000001),
// ligada a una orden de traslado cerrada del mismo cliente.
model ConditioningOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  ocNumber         Int                 @map("oc_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clienteId        String              @map("cliente_id") @db.Uuid
  transferOrderId  String              @map("transfer_order_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant         Plant                       @relation(fields: [plantId], references: [id])
  cliente       Cliente                     @relation(fields: [clienteId], references: [id])
  transferOrder TransferOrder               @relation(fields: [transferOrderId], references: [id])
  createdBy     AppUser                     @relation("conditioningCreatedBy", fields: [createdById], references: [id])
  etiquetas     AcondicionamientoEtiqueta[]

  @@unique([plantId, ocNumber])
  @@index([plantId, status])
  @@index([transferOrderId])
  @@map("conditioning_order")
}

// Etiqueta de Rotulado Acondicionamiento: producto nuevo que resulta de transformar lo
// trasladado en la O.T. de la O.C. (trazabilidad: etiqueta → OC → OT → etiquetas de origen → OP).
model AcondicionamientoEtiqueta {
  id                  String    @id @default(uuid()) @db.Uuid
  plantId             String    @map("plant_id") @db.Uuid
  conditioningOrderId String    @map("conditioning_order_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  tiendaId            String    @map("tienda_id") @db.Uuid
  bodegaId            String?   @map("bodega_id") @db.Uuid
  pieza               Int
  // Código de barras único: A + lote (OC, 7 dígitos) + código de producto + pieza (4 dígitos).
  codigo              String    @unique
  taraKg              Decimal   @map("tara_kg") @db.Decimal(12, 2)
  brutoKg             Decimal   @map("bruto_kg") @db.Decimal(12, 2)
  netoKg              Decimal   @map("neto_kg") @db.Decimal(12, 2)
  empaque             String
  conservacion        String
  temperatura         String
  fechaSacrificio     DateTime  @map("fecha_sacrificio") @db.Date
  fechaEmpaque        DateTime  @map("fecha_empaque") @db.Date
  fechaVencimiento    DateTime? @map("fecha_vencimiento") @db.Date
  ref                 String?
  procesadoPara       String?   @map("procesado_para")
  impresa             Boolean   @default(true)
  estacion            String?
  createdById         String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById         String?   @map("deleted_by") @db.Uuid

  plant             Plant                @relation(fields: [plantId], references: [id])
  conditioningOrder ConditioningOrder    @relation(fields: [conditioningOrderId], references: [id])
  product           Product              @relation(fields: [productId], references: [id])
  tienda            ClienteTienda        @relation(fields: [tiendaId], references: [id])
  bodega            Bodega?              @relation(fields: [bodegaId], references: [id])
  createdBy         AppUser              @relation("acondEtiquetaCreatedBy", fields: [createdById], references: [id])
  deletedBy         AppUser?             @relation("acondEtiquetaDeletedBy", fields: [deletedById], references: [id])
  despacho          DispatchProductItem?

  @@unique([conditioningOrderId, productId, pieza], map: "acond_etiqueta_oc_producto_pieza_key")
  @@index([conditioningOrderId, productId], map: "acond_etiqueta_oc_producto_idx")
  @@index([bodegaId])
  @@map("acondicionamiento_etiqueta")
}

// Producto (etiqueta de pieza o canastilla de Rotulado) trasladado a proceso en una O.T.:
// sigue en el inventario, pero queda marcado "en proceso". Se repesa al trasladar.
model TransferOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  transferOrderId String   @map("transfer_order_id") @db.Uuid
  etiquetaId      String?  @unique @map("etiqueta_id") @db.Uuid
  canastillaId    String?  @unique @map("canastilla_id") @db.Uuid
  codigo          String
  productId       String   @map("product_id") @db.Uuid
  unds            Int
  pesoKg          Decimal  @map("peso_kg") @db.Decimal(12, 2)
  taraKg          Decimal  @map("tara_kg") @db.Decimal(12, 2)
  netoKg          Decimal  @map("neto_kg") @db.Decimal(12, 2)
  // Neto que traía la etiqueta, para comparar con el repesaje.
  netoEtiquetaKg  Decimal  @map("neto_etiqueta_kg") @db.Decimal(12, 2)
  createdById     String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transferOrder TransferOrder       @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  etiqueta      RotuladoEtiqueta?   @relation(fields: [etiquetaId], references: [id])
  canastilla    RotuladoCanastilla? @relation(fields: [canastillaId], references: [id])
  product       Product             @relation(fields: [productId], references: [id])
  createdBy     AppUser             @relation("transferItemCreatedBy", fields: [createdById], references: [id])

  @@index([transferOrderId])
  @@map("transfer_order_item")
}

// Orden de Producción (O.P.): consecutivo propio por planta (OP0000001),
// ligada a una orden de despacho activa del mismo cliente.
model ProductionOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  opNumber         Int                 @map("op_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clienteId        String              @map("cliente_id") @db.Uuid
  dispatchOrderId  String              @map("dispatch_order_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant                Plant                   @relation(fields: [plantId], references: [id])
  cliente              Cliente                 @relation(fields: [clienteId], references: [id])
  dispatchOrder        DispatchOrder           @relation(fields: [dispatchOrderId], references: [id])
  createdBy            AppUser                 @relation("productionCreatedBy", fields: [createdById], references: [id])
  rotuladoConsecutivos RotuladoConsecutivo[]
  rotuladoConsecutivosEstacion RotuladoConsecutivoEstacion[]
  etiquetas            RotuladoEtiqueta[]
  canastillas          RotuladoCanastilla[]
  tiendas              ProductionOrderTienda[]

  @@unique([plantId, opNumber])
  @@index([plantId, status])
  @@index([dispatchOrderId])
  @@map("production_order")
}

model RotuladoConsecutivo {
  plantId           String   @map("plant_id") @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  ultimo            Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant           Plant           @relation(fields: [plantId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@id([plantId, productionOrderId, productId])
  @@map("rotulado_consecutivo")
}

// Consecutivo de piezas por estación (número sacado del nombre de la estación: DBOVINO3 → 3).
// Cada estación numera sus propias piezas; la estación va dentro del código de barras, así
// dos estaciones rotulando a la vez nunca generan el mismo código. La estación 0 (sin número
// en el nombre) sigue usando RotuladoConsecutivo.
model RotuladoConsecutivoEstacion {
  plantId           String   @map("plant_id") @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  estacion          Int
  ultimo            Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant           Plant           @relation(fields: [plantId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@id([plantId, productionOrderId, productId, estacion])
  @@map("rotulado_consecutivo_estacion")
}

// Preparar orden: cuántas canales de la orden de producción van a cada tienda del cliente.
model ProductionOrderTienda {
  id                String   @id @default(uuid()) @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  tiendaId          String   @map("tienda_id") @db.Uuid
  cantidad          Int
  createdById       String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  tienda          ClienteTienda   @relation(fields: [tiendaId], references: [id])
  createdBy       AppUser         @relation("productionTiendaCreatedBy", fields: [createdById], references: [id])

  @@unique([productionOrderId, tiendaId])
  @@map("production_order_tienda")
}

// Etiqueta de producto impresa en Rotulado Desposte, ligada a su orden de producción.
model RotuladoEtiqueta {
  id                String    @id @default(uuid()) @db.Uuid
  plantId           String    @map("plant_id") @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  tiendaId          String    @map("tienda_id") @db.Uuid
  bodegaId          String?   @map("bodega_id") @db.Uuid
  pieza             Int
  // Código de barras único: lote (OP, 7 dígitos) + código de producto + pieza (4 dígitos).
  codigo            String?   @unique
  taraKg            Decimal   @map("tara_kg") @db.Decimal(12, 2)
  brutoKg           Decimal   @map("bruto_kg") @db.Decimal(12, 2)
  netoKg            Decimal   @map("neto_kg") @db.Decimal(12, 2)
  empaque           String
  conservacion      String
  temperatura       String
  fechaSacrificio   DateTime  @map("fecha_sacrificio") @db.Date
  fechaEmpaque      DateTime  @map("fecha_empaque") @db.Date
  fechaVencimiento  DateTime? @map("fecha_vencimiento") @db.Date
  ref               String?
  procesadoPara     String?   @map("procesado_para")
  impresa           Boolean   @default(true)
  // Pieza etiquetada cuando la tienda ya tenía completo el producto.
  sobrante          Boolean   @default(false)
  canastillaId      String?   @map("canastilla_id") @db.Uuid
  // Equipo (estación) donde se imprimió la etiqueta.
  estacion          String?
  createdById       String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById       String?   @map("deleted_by") @db.Uuid

  plant           Plant                @relation(fields: [plantId], references: [id])
  productionOrder ProductionOrder      @relation(fields: [productionOrderId], references: [id])
  product         Product              @relation(fields: [productId], references: [id])
  tienda          ClienteTienda        @relation(fields: [tiendaId], references: [id])
  bodega          Bodega?              @relation(fields: [bodegaId], references: [id])
  canastilla      RotuladoCanastilla?  @relation(fields: [canastillaId], references: [id])
  createdBy       AppUser              @relation("rotuladoEtiquetaCreatedBy", fields: [createdById], references: [id])
  deletedBy       AppUser?             @relation("rotuladoEtiquetaDeletedBy", fields: [deletedById], references: [id])
  traslado        TransferOrderItem?
  despacho        DispatchProductItem?

  @@unique([productionOrderId, productId, pieza])
  @@index([productionOrderId, productId, tiendaId])
  @@index([canastillaId])
  @@map("rotulado_etiqueta")
}

// Canastilla (caja) de Rotulado Desposte: agrupa piezas de un producto para una tienda.
// Mientras cerradaAt es null sigue abierta (máximo una abierta por orden y producto).
model RotuladoCanastilla {
  id                String    @id @default(uuid()) @db.Uuid
  plantId           String    @map("plant_id") @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  tiendaId          String    @map("tienda_id") @db.Uuid
  numero            Int
  // Código de barras único: lote (OP, 7 dígitos) + código de producto + C + canastilla (3 dígitos).
  codigo            String?   @unique
  taraKg            Decimal?  @map("tara_kg") @db.Decimal(12, 2)
  brutoKg           Decimal?  @map("bruto_kg") @db.Decimal(12, 2)
  netoKg            Decimal?  @map("neto_kg") @db.Decimal(12, 2)
  unds              Int?
  cerradaAt         DateTime? @map("cerrada_at") @db.Timestamptz(6)
  cerradaById       String?   @map("cerrada_by") @db.Uuid
  createdById       String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  productionOrder ProductionOrder      @relation(fields: [productionOrderId], references: [id])
  tienda          ClienteTienda        @relation(fields: [tiendaId], references: [id])
  etiquetas       RotuladoEtiqueta[]
  traslado        TransferOrderItem?
  despacho        DispatchProductItem?

  @@unique([productionOrderId, productId, numero])
  @@index([productionOrderId, productId, cerradaAt])
  @@map("rotulado_canastilla")
}

// Salida de una pieza de canal de su cava hacia una orden de despacho. Mientras la
// orden está activa la pieza sigue en el inventario de su cava de origen (marcada con
// la orden); queda registrado el peso y quién la despachó (trazabilidad hacia atrás).
model DispatchOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  dispatchOrderId String   @map("dispatch_order_id") @db.Uuid
  canalPiezaId    String   @unique @map("canal_pieza_id") @db.Uuid
  cavaOrigen      String   @map("cava_origen")
  pesoCalienteKg  Decimal  @map("peso_caliente_kg") @db.Decimal(12, 2)
  despachoKg      Decimal? @map("despacho_kg") @db.Decimal(12, 2)
  createdById     String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id])
  canalPieza    CanalPieza    @relation(fields: [canalPiezaId], references: [id])
  createdBy     AppUser       @relation("dispatchItemCreatedBy", fields: [createdById], references: [id])

  @@index([dispatchOrderId])
  @@map("dispatch_order_item")
}

// Recibo en Canal: orden de recibo de canales. Solo el registro; luego se
// consume en otro módulo. Numeración propia por planta.
model CanalReceiptOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  receiptNumber    Int                 @map("receipt_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clientId         String              @map("client_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant     Plant              @relation(fields: [plantId], references: [id])
  client    Client             @relation(fields: [clientId], references: [id])
  createdBy AppUser            @relation("canalReceiptCreatedBy", fields: [createdById], references: [id])
  items     CanalReceiptItem[]

  @@unique([plantId, receiptNumber])
  @@index([plantId, status])
  @@map("canal_receipt_order")
}

// Recibo en Posta: orden de recibo (solo registro, sin ítems). Numeración propia por planta.
model PostaReceiptOrder {
  id               String              @id @default(uuid()) @db.Uuid
  plantId          String              @map("plant_id") @db.Uuid
  receiptNumber    Int                 @map("receipt_number")
  registrationDate DateTime            @map("registration_date") @db.Date
  processDate      DateTime            @map("process_date") @db.Date
  clientId         String              @map("client_id") @db.Uuid
  status           DispatchOrderStatus @default(activo)
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  plant     Plant              @relation(fields: [plantId], references: [id])
  client    Client             @relation(fields: [clientId], references: [id])
  createdBy AppUser            @relation("postaReceiptCreatedBy", fields: [createdById], references: [id])
  items     PostaReceiptItem[]

  @@unique([plantId, receiptNumber])
  @@index([plantId, status])
  @@map("posta_receipt_order")
}

// Animal/pieza pesado dentro de una orden de recibo en Posta.
model PostaReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  receiptOrderId String   @map("receipt_order_id") @db.Uuid
  plantId        String   @map("plant_id") @db.Uuid
  codigo         Int
  productId      String   @map("product_id") @db.Uuid
  taraKg         Decimal  @map("tara_kg") @db.Decimal(12, 2)
  brutoKg        Decimal  @map("bruto_kg") @db.Decimal(12, 2)
  netoKg         Decimal  @map("neto_kg") @db.Decimal(12, 2)
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receiptOrder PostaReceiptOrder @relation(fields: [receiptOrderId], references: [id], onDelete: Cascade)
  plant        Plant             @relation(fields: [plantId], references: [id])
  product      Product           @relation(fields: [productId], references: [id])
  createdBy    AppUser           @relation("postaReceiptItemCreatedBy", fields: [createdById], references: [id])

  @@index([receiptOrderId])
  @@map("posta_receipt_item")
}

// Canal pesado dentro de una orden de recibo (Recibo de Canales).
model CanalReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  receiptOrderId String   @map("receipt_order_id") @db.Uuid
  plantId        String   @map("plant_id") @db.Uuid
  codigo         Int
  cava           Int
  pesoKg         Decimal  @map("peso_kg") @db.Decimal(12, 2)
  guia           String?
  lote           String?
  identificacion String?
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receiptOrder CanalReceiptOrder @relation(fields: [receiptOrderId], references: [id], onDelete: Cascade)
  plant        Plant             @relation(fields: [plantId], references: [id])
  createdBy    AppUser           @relation("canalReceiptItemCreatedBy", fields: [createdById], references: [id])

  @@index([receiptOrderId])
  @@map("canal_receipt_item")
}

// Catálogo simple de productos (consulta en módulos de recibo/etiquetado).
model Product {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @map("plant_id") @db.Uuid
  codigo    String
  nombre    String
  categoria String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plant                      Plant                       @relation(fields: [plantId], references: [id])
  postaReceiptItems          PostaReceiptItem[]
  clientes                   ClienteProducto[]
  rotuladoConsecutivos       RotuladoConsecutivo[]
  rotuladoConsecutivosEstacion RotuladoConsecutivoEstacion[]
  rotuladoEtiquetas          RotuladoEtiqueta[]
  transferItems              TransferOrderItem[]
  dispatchProductItems       DispatchProductItem[]
  acondicionamientoEtiquetas AcondicionamientoEtiqueta[]

  @@unique([plantId, codigo])
  @@index([plantId])
  @@map("product")
}

// ======================= ORGANIZACIÓN / SEGURIDAD ==========================

model Plant {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  legalName      String   @map("legal_name")
  invimaRegistry String?  @map("invima_registry")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                      AppUser[]
  suppliers                  Supplier[]
  goodsReceipts              GoodsReceipt[]
  devices                    Device[]
  dispatchOrders             DispatchOrder[]
  productionOrders           ProductionOrder[]
  transferOrders             TransferOrder[]
  conditioningOrders         ConditioningOrder[]
  canalDispatchOrders        CanalDispatchOrder[]
  rotuladoConsecutivos       RotuladoConsecutivo[]
  rotuladoConsecutivosEstacion RotuladoConsecutivoEstacion[]
  rotuladoEtiquetas          RotuladoEtiqueta[]
  acondicionamientoEtiquetas AcondicionamientoEtiqueta[]
  canalReceipts              CanalReceiptOrder[]
  canalReceiptItems          CanalReceiptItem[]
  postaReceipts              PostaReceiptOrder[]
  postaReceiptItems          PostaReceiptItem[]
  products                   Product[]
  traceUnits                 TraceUnit[]
  traceEvents                TraceEvent[]

  @@map("plant")
}

model AppUser {
  id           String    @id @default(uuid()) @db.Uuid
  plantId      String    @map("plant_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  pinHash      String?   @map("pin_hash")
  fullName     String    @map("full_name")
  documentId   String?   @unique @map("document_id")
  role         UserRole
  active       Boolean   @default(true)
  // Permisos por módulo (Configuración → Permisos), independientes del rol.
  // accesoTotal = todos los módulos (también los que se agreguen después);
  // si no, solo las rutas del menú listadas en `modulos`.
  accesoTotal  Boolean   @default(false) @map("acceso_total")
  modulos      String[]  @default([])
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant Plant @relation(fields: [plantId], references: [id])

  receiptsReceived          GoodsReceipt[]              @relation("receiptReceivedBy")
  dispatchOrders            DispatchOrder[]             @relation("dispatchCreatedBy")
  dispatchItems             DispatchOrderItem[]         @relation("dispatchItemCreatedBy")
  productionOrders          ProductionOrder[]           @relation("productionCreatedBy")
  transferOrders            TransferOrder[]             @relation("transferCreatedBy")
  transferItems             TransferOrderItem[]         @relation("transferItemCreatedBy")
  dispatchProductItems      DispatchProductItem[]       @relation("dispatchProductItemCreatedBy")
  conditioningOrders        ConditioningOrder[]         @relation("conditioningCreatedBy")
  canalDispatchOrders       CanalDispatchOrder[]        @relation("canalDispatchCreatedBy")
  canalDispatchItems        CanalDispatchOrderItem[]    @relation("canalDispatchItemCreatedBy")
  rotuladoEtiquetas         RotuladoEtiqueta[]          @relation("rotuladoEtiquetaCreatedBy")
  rotuladoEtiquetasBorradas RotuladoEtiqueta[]          @relation("rotuladoEtiquetaDeletedBy")
  acondEtiquetas            AcondicionamientoEtiqueta[] @relation("acondEtiquetaCreatedBy")
  acondEtiquetasBorradas    AcondicionamientoEtiqueta[] @relation("acondEtiquetaDeletedBy")
  productionTiendas         ProductionOrderTienda[]     @relation("productionTiendaCreatedBy")
  canalReceipts             CanalReceiptOrder[]         @relation("canalReceiptCreatedBy")
  canalReceiptItems         CanalReceiptItem[]          @relation("canalReceiptItemCreatedBy")
  postaReceipts             PostaReceiptOrder[]         @relation("postaReceiptCreatedBy")
  postaReceiptItems         PostaReceiptItem[]          @relation("postaReceiptItemCreatedBy")
  traceEvents               TraceEvent[]

  @@index([plantId])
  @@map("app_user")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  plantId     String   @map("plant_id") @db.Uuid
  name        String
  icaFarmCode String?  @map("ica_farm_code")
  documentId  String?  @map("document_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant         Plant          @relation(fields: [plantId], references: [id])
  goodsReceipts GoodsReceipt[]

  @@index([plantId])
  @@map("supplier")
}

// Equipos (PCs) autorizados a acceder al software, identificados por MAC.
// La MAC la entrega el agente local instalado en cada PC.
model Device {
  id          String    @id @default(uuid()) @db.Uuid
  plantId     String    @map("plant_id") @db.Uuid
  mac         String    @unique
  name        String
  description String?
  hostname    String?
  active      Boolean   @default(true)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant Plant @relation(fields: [plantId], references: [id])

  @@index([plantId])
  @@map("device")
}

// ===================== INGRESO DE MERCANCÍA (frontera) =====================

model GoodsReceipt {
  id            String             @id @default(uuid()) @db.Uuid
  plantId       String             @map("plant_id") @db.Uuid
  receiptNumber String             @map("receipt_number")
  supplierId    String             @map("supplier_id") @db.Uuid
  originIcaCode String?            @map("origin_ica_code")
  receivedDate  DateTime           @map("received_date") @db.Date
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  status        GoodsReceiptStatus @default(borrador)
  receivedById  String             @map("received_by") @db.Uuid
  extra         Json?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  plant      Plant              @relation(fields: [plantId], references: [id])
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  receivedBy AppUser            @relation("receiptReceivedBy", fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]

  @@unique([plantId, receiptNumber])
  @@index([plantId, status])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id             String                 @id @default(uuid()) @db.Uuid
  plantId        String                 @map("plant_id") @db.Uuid
  goodsReceiptId String                 @map("goods_receipt_id") @db.Uuid
  itemCode       String                 @map("item_code")
  unitForm       UnitForm               @map("unit_form")
  quarterType    QuarterType?           @map("quarter_type")
  weightKg       Decimal                @map("weight_kg") @db.Decimal(10, 3)
  species        Species                @default(bovino)
  status         GoodsReceiptItemStatus @default(disponible)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  @@index([plantId, status])
  @@index([goodsReceiptId])
  @@map("goods_receipt_item")
}

// ---- Tablas de auditoría (escritas por triggers fn_audit; sin FK a propósito
// ---- para no bloquear operaciones ni borrados de las entidades auditadas) ----

model GoodsReceiptAudit {
  auditId   BigInt   @id @default(autoincrement()) @map("audit_id")
  operation String
  rowId     String?  @map("row_id") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy String?  @map("changed_by") @db.Uuid
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")

  @@index([rowId])
  @@index([changedAt])
  @@map("goods_receipt_audit")
}

model GoodsReceiptItemAudit {
  auditId   BigInt   @id @default(autoincrement()) @map("audit_id")
  operation String
  rowId     String?  @map("row_id") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy String?  @map("changed_by") @db.Uuid
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")

  @@index([rowId])
  @@index([changedAt])
  @@map("goods_receipt_item_audit")
}

// ======================= TRAZABILIDAD (unidad + evento) =====================
// Nota: TraceLink (DAG de relaciones padre/hijo) se elimino por no usarse;
// solo se usan TraceUnit/TraceEvent (goods-receipt.service.ts, un evento de
// ingreso + una unidad raiz por cada item recibido).

model TraceUnit {
  id         String          @id @default(uuid()) @db.Uuid
  plantId    String          @map("plant_id") @db.Uuid
  unitType   TraceUnitType   @map("unit_type")
  entityId   String          @map("entity_id") @db.Uuid
  publicCode String          @map("public_code")
  status     TraceUnitStatus @default(activa)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant Plant @relation(fields: [plantId], references: [id])

  @@unique([unitType, entityId])
  @@index([plantId, unitType])
  @@map("trace_unit")
}

model TraceEvent {
  id         String         @id @default(uuid()) @db.Uuid
  plantId    String         @map("plant_id") @db.Uuid
  eventType  TraceEventType @map("event_type")
  actorId    String         @map("actor_id") @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  payload    Json?

  plant Plant   @relation(fields: [plantId], references: [id])
  actor AppUser @relation(fields: [actorId], references: [id])

  @@index([plantId, eventType])
  @@index([occurredAt])
  @@map("trace_event")
}

// ==================== PESO EN PIE / INSENSIBILIZACIÓN =====================
// Peso en Pie reporta los animales que llegaron (guía de movilidad, corral,
// cantidad, peso individual o promediado). Cada reporte es la "orden" que se
// procesa en Insensibilización, donde se marca cada animal (1..N) con su hora.

enum PesoEnPieTipoPesaje {
  individual
  promediado
}

enum PesoEnPieStatus {
  pendiente
  en_insensibilizacion
  procesado
}

enum InsensibilizacionStatus {
  en_proceso
  completada
}

enum OrdenBeneficioStatus {
  activo
  inactivo
  procesado
}

enum CanalTipo {
  canal_completa
  media_canal_con_cola
  media_canal_sin_cola
  // Media canal genérica: CIZQ y CDER son piezas independientes que se
  // pueden pesar en cualquier orden; "con cola"/"sin cola" es una
  // clasificación aparte (ver OrdenBeneficioEvento.conCola).
  media_canal
}

enum CanalPiezaTipo {
  canal
  cizq
  cder
}

// Tipo/categoría del animal en Canal Caliente (distinto de sexo en Peso en Pie).
enum CanalAnimalTipo {
  vaca
  novilla
  toro
  novillo
  bufala
  bufalo
}

// El catálogo de subproductos (códigos SIESA, nombre y unidad) vive en
// apps/api/src/modules/subproductos/subproducto-items.ts; "tipo" aquí es solo
// el identificador (slug) de ese catálogo, guardado como texto libre para no
// depender de una migración de enum cada vez que cambie el listado.

// Destino de TODAS las vísceras (rojas y blancas) de un lote: se quedan como
// inventario de la empresa, o el firmante/cliente de la orden se las lleva.
enum SubproductoDestino {
  empresa
  firmante
}

model PesoEnPie {
  id             String              @id @default(uuid()) @db.Uuid
  plantId        String              @map("plant_id") @db.Uuid
  reference      Int
  bpReference    Int                 @map("bp_reference")
  bcReference    Int?                @map("bc_reference")
  date           DateTime            @db.Date
  guia           String?
  procedencia    String?
  proveedor      String?
  cliente        String?
  placa          String?
  conductor      String?
  corral         String?
  tipoAnimal     String?             @map("tipo_animal")
  lote           String?
  animalNo       String?             @map("animal_no")
  animalCount    Int                 @map("animal_count")
  tipoPesaje     PesoEnPieTipoPesaje @default(promediado) @map("tipo_pesaje")
  pesoTotalKg    Decimal?            @map("peso_total_kg") @db.Decimal(12, 2)
  pesoPromedioKg Decimal?            @map("peso_promedio_kg") @db.Decimal(12, 2)
  cantidad       Int?
  entrada        Decimal?            @db.Decimal(12, 2)
  salida         Decimal?            @db.Decimal(12, 2)
  observaciones  String?
  status         PesoEnPieStatus     @default(pendiente)
  createdById    String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)

  insensibilizacion Insensibilizacion?
  repesajes         PesoEnPieRepesaje[]

  @@unique([plantId, bpReference, reference])
  @@index([plantId, bpReference])
  @@index([plantId, status])
  @@map("peso_en_pie")
}

// Historial de repesajes de un animal de Peso en Pie (guía ya cerrada). El
// peso vigente queda en PesoEnPie.pesoTotalKg (es el que cuenta para el
// beneficio); aquí se guarda cada ronda con su peso anterior, el nuevo y la
// merma (anterior - nuevo). El peso inicial es pesoAnteriorKg de la ronda 1.
model PesoEnPieRepesaje {
  id             String   @id @default(uuid()) @db.Uuid
  plantId        String   @map("plant_id") @db.Uuid
  pesoEnPieId    String   @map("peso_en_pie_id") @db.Uuid
  ronda          Int
  pesoAnteriorKg Decimal  @map("peso_anterior_kg") @db.Decimal(12, 2)
  pesoNuevoKg    Decimal  @map("peso_nuevo_kg") @db.Decimal(12, 2)
  mermaKg        Decimal  @map("merma_kg") @db.Decimal(12, 2)
  operatorId     String   @map("operator_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pesoEnPie PesoEnPie @relation(fields: [pesoEnPieId], references: [id])

  @@unique([pesoEnPieId, ronda])
  @@index([plantId, createdAt])
  @@map("peso_en_pie_repesaje")
}

model Insensibilizacion {
  id          String                  @id @default(uuid()) @db.Uuid
  plantId     String                  @map("plant_id") @db.Uuid
  pesoEnPieId String                  @unique @map("peso_en_pie_id") @db.Uuid
  status      InsensibilizacionStatus @default(en_proceso)
  startedAt   DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?               @map("finished_at") @db.Timestamptz(6)
  createdById String                  @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  pesoEnPie PesoEnPie                 @relation(fields: [pesoEnPieId], references: [id])
  eventos   InsensibilizacionEvento[]

  @@index([plantId, status])
  @@map("insensibilizacion")
}

model InsensibilizacionEvento {
  id                  String   @id @default(uuid()) @db.Uuid
  insensibilizacionId String   @map("insensibilizacion_id") @db.Uuid
  sequence            Int
  stunnedAt           DateTime @default(now()) @map("stunned_at") @db.Timestamptz(6)
  operatorId          String   @map("operator_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  insensibilizacion Insensibilizacion @relation(fields: [insensibilizacionId], references: [id])

  @@unique([insensibilizacionId, sequence])
  @@index([insensibilizacionId])
  @@map("insensibilizacion_evento")
}

// ===================== ORDEN DE BENEFICIO =================================
// Agrupa, por cliente y día, los animales validados en Peso en Pie (báscula en
// pie) cuyas guías coinciden con las registradas en Peso en Camión (báscula en
// camión). Al crearse alimenta el módulo de Insensibilización.

model OrdenBeneficio {
  id            String               @id @default(uuid()) @db.Uuid
  plantId       String               @map("plant_id") @db.Uuid
  reference     Int
  date          DateTime             @db.Date
  cliente       String
  guias         String[]
  animalCount   Int                  @map("animal_count")
  observaciones String?
  status        OrdenBeneficioStatus @default(activo)
  createdById   String               @map("created_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)

  // Destino de las vísceras del lote y constancia de su retiro por el
  // firmante (cuando no se quedan como inventario de la empresa).
  subproductoDestino             SubproductoDestino @default(empresa) @map("subproducto_destino")
  subproductoRetiroAt            DateTime?          @map("subproducto_retiro_at") @db.Timestamptz(6)
  subproductoRetiroById          String?            @map("subproducto_retiro_by") @db.Uuid
  subproductoRetiroObservaciones String?            @map("subproducto_retiro_observaciones")

  // Si el lote requiere tiquete de cabeza y patas por animal: al insensibilizar
  // cada animal se imprime un tiquete con su info + las 4 patas.
  cabezasPatas Boolean @default(false) @map("cabezas_patas")

  // Trazabilidad hacia atrás: consecutivos de Peso en Camión (BC) y
  // Peso en Pie (BP) de donde provienen los animales de este lote,
  // resueltos por guía al momento de crear la orden.
  pcReference Int? @map("pc_reference")
  bpReference Int? @map("bp_reference")

  eventos OrdenBeneficioEvento[]

  @@unique([plantId, date, reference])
  @@index([plantId, status])
  @@map("orden_beneficio")
}

model OrdenBeneficioEvento {
  id               String   @id @default(uuid()) @db.Uuid
  ordenBeneficioId String   @map("orden_beneficio_id") @db.Uuid
  sequence         Int
  stunnedAt        DateTime @default(now()) @map("stunned_at") @db.Timestamptz(6)
  operatorId       String   @map("operator_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Peso de la piel del animal caído (módulo Pieles).
  pesoPielKg     Decimal?  @map("peso_piel_kg") @db.Decimal(12, 2)
  pieladoAt      DateTime? @map("pielado_at") @db.Timestamptz(6)
  pielOperatorId String?   @map("piel_operator_id") @db.Uuid

  // Clasificación del animal en Canal Caliente (especie/categoría).
  canalAnimalTipo CanalAnimalTipo? @map("canal_animal_tipo")
  // Tipo de pesaje en Canal Caliente, elegido por animal.
  canalTipo       CanalTipo?       @map("canal_tipo")
  // Si la media canal se dejó con cola o sin cola (independiente de si se
  // pesó primero CIZQ o CDER).
  conCola         Boolean?         @map("con_cola")
  // Expendio del animal (para el presinto/etiqueta de Canal Caliente).
  expendio        String?

  ordenBeneficio OrdenBeneficio    @relation(fields: [ordenBeneficioId], references: [id])
  canalPiezas    CanalPieza[]
  subproductos   SubproductoItem[]

  @@unique([ordenBeneficioId, sequence])
  @@index([ordenBeneficioId])
  @@map("orden_beneficio_evento")
}

// Traslado de una PIEZA de canal entre cavas: deja constancia de quién lo
// hizo, cuándo, de dónde a dónde y por qué motivo, para trazabilidad real
// del inventario. Es por pieza (no por animal) porque CIZQ y CDER de una
// misma media canal pueden estar en cavas distintas.
model CanalTraslado {
  id          String   @id @default(uuid()) @db.Uuid
  plantId     String   @map("plant_id") @db.Uuid
  piezaId     String   @map("canal_pieza_id") @db.Uuid
  cavaOrigen  String?  @map("cava_origen")
  cavaDestino String   @map("cava_destino")
  motivo      String
  operatorId  String   @map("operator_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pieza CanalPieza @relation(fields: [piezaId], references: [id])

  @@index([piezaId])
  @@index([plantId, createdAt])
  @@map("canal_traslado")
}

// Checklist de subproductos generado automáticamente al caer cada animal:
// una fila por cada producto del catálogo (ver subproducto-items.ts). Se
// marca por unidad, o se pesa en kilos, según el producto.
model SubproductoItem {
  id           String    @id @default(uuid()) @db.Uuid
  eventoId     String    @map("orden_beneficio_evento_id") @db.Uuid
  tipo         String    @db.VarChar(60)
  marcado      Boolean   @default(false)
  pesoKg       Decimal?  @map("peso_kg") @db.Decimal(12, 2)
  cava         String?
  registradoAt DateTime? @map("registrado_at") @db.Timestamptz(6)
  operatorId   String?   @map("operator_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  evento OrdenBeneficioEvento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, tipo])
  @@index([eventoId])
  @@map("subproducto_item")
}

// Peso del canal caliente por PIEZA de cada animal. Canal completa = 1 pieza
// (canal); media canal = 2 piezas (cizq izquierda, cder derecha). El tipo de
// canal vive en OrdenBeneficioEvento.canalTipo (por animal). La bodega/cava/
// destino/observaciones son por PIEZA: CIZQ y CDER pueden ir a cavas distintas.
model CanalPieza {
  id         String         @id @default(uuid()) @db.Uuid
  eventoId   String         @map("orden_beneficio_evento_id") @db.Uuid
  pieza      CanalPiezaTipo
  pesoKg     Decimal        @map("peso_kg") @db.Decimal(12, 2)
  // Consecutivo diario del animal al momento de pesar (mismo orden en que se
  // tumbó/pesó): ya no se elige a mano, viaja automáticamente con el animal.
  turno      Int?
  weighedAt  DateTime       @default(now()) @map("weighed_at") @db.Timestamptz(6)
  operatorId String         @map("operator_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  bodega        String?
  cava          String?
  destino       String?
  observaciones String?

  evento        OrdenBeneficioEvento    @relation(fields: [eventoId], references: [id])
  trasladosCava CanalTraslado[]
  despacho      DispatchOrderItem?
  despachoCanal CanalDispatchOrderItem?

  @@unique([eventoId, pieza])
  @@index([eventoId])
  @@map("canal_pieza")
}

// ====================== HISTÓRICO SACRIFICIO ======================

// Hoja BENEFICIO del Excel "BENEFICIO BOVINOS": una fila por guía/lote
// beneficiado. Semana, total reses, promedio, rendimiento y total sacrificio
// se calculan; la tarifa queda guardada en la fila (la vigente al registrarla).
model HistoricoBeneficio {
  id               String    @id @default(uuid()) @db.Uuid
  plantId          String    @map("plant_id") @db.Uuid
  fecha            DateTime  @db.Date
  proveedor        String?
  firmador         String?
  cliente          String?
  granja           String?
  municipio        String?
  guiaIca          String?   @map("guia_ica")
  lote             Int?
  novillo          Int       @default(0)
  novilla          Int       @default(0)
  vaca             Int       @default(0)
  toro             Int       @default(0)
  bufalo           Int       @default(0)
  pieles           Int?
  pesoPieKg        Decimal?  @map("peso_pie_kg") @db.Decimal(12, 2)
  pesoCalienteKg   Decimal?  @map("peso_caliente_kg") @db.Decimal(12, 2)
  tarifa           Decimal?  @db.Decimal(14, 2)
  // Orden de beneficio de la que se generó la fila automáticamente al
  // terminar Canal Caliente (null = fila importada del Excel o digitada).
  ordenBeneficioId String?   @unique @map("orden_beneficio_id") @db.Uuid
  createdById      String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([plantId, fecha])
  @@map("historico_beneficio")
}

// Hoja TARIFAS (tabla CLIENTE / VALOR BASE): tarifa de sacrificio por firmador.
model HistoricoTarifa {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @map("plant_id") @db.Uuid
  cliente   String
  valorBase Decimal  @map("valor_base") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([plantId, cliente])
  @@map("historico_tarifa")
}

// Hoja RETOMAS: subproductos que se retoman por firmador y fecha. Los valores
// unitarios se guardan en la fila (salen de la tarifa del firmador, pero en
// la hoja a veces se digitaban a mano); los totales se calculan.
model HistoricoRetoma {
  id                 String    @id @default(uuid()) @db.Uuid
  plantId            String    @map("plant_id") @db.Uuid
  fecha              DateTime  @db.Date
  firmador           String?
  reses              Int       @default(0)
  cabezas            Int?
  despojos           Int?
  libros             Int?
  pielesKg           Decimal?  @map("pieles_kg") @db.Decimal(12, 2)
  viscerasRojas      Int?      @map("visceras_rojas")
  seboKg             Decimal?  @map("sebo_kg") @db.Decimal(12, 2)
  valorCabezas       Decimal   @default(0) @map("valor_cabezas") @db.Decimal(14, 2)
  valorDespojos      Decimal   @default(0) @map("valor_despojos") @db.Decimal(14, 2)
  valorLibros        Decimal   @default(0) @map("valor_libros") @db.Decimal(14, 2)
  valorPieles        Decimal   @default(0) @map("valor_pieles") @db.Decimal(14, 2)
  valorViscerasRojas Decimal   @default(0) @map("valor_visceras_rojas") @db.Decimal(14, 2)
  valorSebo          Decimal   @default(0) @map("valor_sebo") @db.Decimal(14, 2)
  createdById        String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([plantId, fecha])
  @@map("historico_retoma")
}

// Hoja TARIFAS (tabla CLIENTES / CABEZAS / DESPOJOS / LIBROS / PIELES / SEBO /
// VISCERA ROJA): valor unitario de cada subproducto retomado por firmador.
model HistoricoTarifaSubproducto {
  id            String   @id @default(uuid()) @db.Uuid
  plantId       String   @map("plant_id") @db.Uuid
  cliente       String
  cabezas       Decimal  @default(0) @db.Decimal(14, 2)
  despojos      Decimal  @default(0) @db.Decimal(14, 2)
  libros        Decimal  @default(0) @db.Decimal(14, 2)
  pieles        Decimal  @default(0) @db.Decimal(14, 2)
  sebo          Decimal  @default(0) @db.Decimal(14, 2)
  viscerasRojas Decimal  @default(0) @map("visceras_rojas") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([plantId, cliente])
  @@map("historico_tarifa_subproducto")
}
