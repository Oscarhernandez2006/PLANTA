{
  "name": "@frigorifico/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio (Electron) que envuelve el frontend y valida el equipo por MAC nativa.",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "copy:web": "node copy-web.js",
    "prepack": "node copy-web.js",
    "pack": "electron-builder --dir",
    "predist": "node copy-web.js",
    "dist": "electron-builder",
    "dist:publish": "node copy-web.js && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.frigorifico.planta",
    "productName": "Frigorifico Planta",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "open-touch-keyboard.ps1",
      "print-raw.ps1",
      "print-raw-worker.ps1",
      "web/**"
    ],
    "asarUnpack": [
      "open-touch-keyboard.ps1",
      "print-raw.ps1",
      "print-raw-worker.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frigorifico Planta",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Frigorifico-Planta-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Oscarhernandez2006",
        "repo": "PLANTA",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "electron-updater": "^6.3.9",
    "serialport": "^13.0.0"
  }
}
